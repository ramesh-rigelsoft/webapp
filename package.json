{
  "name": "rigelEims",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
   "build": {
    "appId": "com.rigel.eims.desktop",
    "productName": "RigelEIMS",
    "win": {
      "target": "nsis",
      "icon": "./logo/logo.ico"
    },

    "linux": {
      "target": "AppImage",
      "icon": "./logo/logo.ico"
    },

    "mac": {
      "target": "dmg",
      "icon": "./logo/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "./license.txt"  
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  }
}
